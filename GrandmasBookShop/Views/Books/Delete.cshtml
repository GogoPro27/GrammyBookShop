@model GrandmasBookShop.Models.Book
@{
    ViewData["Title"] = "Избриши книга";
}

<h1>Избриши книга</h1>
<hr />

<h3>Дали сте сигурни дека сакате да ја избришете оваа книга?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">Име</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Автор</dt>
        <dd class="col-sm-10">@Model.Author</dd>
        <dt class="col-sm-2">Опис</dt>
        <dd class="col-sm-10">@Model.Description</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Избриши" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Назад кон список</a>
    </form>
</div>
