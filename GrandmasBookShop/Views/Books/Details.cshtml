@model GrandmasBookShop.Models.Book
@{
    ViewData["Title"] = "Детали за книга";
}

<h1>Детали за книга</h1>

<div class="card mb-3">
    <div class="card-body">
        <h4 class="card-title">@Model.Name</h4>
        <p class="card-text"><strong>Автор:</strong> @Model.Author</p>
        <p class="card-text"><strong>Жанр:</strong> @Model.Genre</p>
        <p class="card-text"><strong>Опис:</strong> @Model.Description</p>
        <p class="card-text">
            <strong>Цена:</strong>
            @if (Model.CopiesAvailable == 0)
            {
                <span class="text-danger">Продадено</span>
            }
            else
            {
                @string.Format("{0:N0} ден", Model.Price)
            }
        </p>
        <p class="card-text"><strong>Достапни примероци:</strong> @Model.CopiesAvailable</p>
        @if (!string.IsNullOrEmpty(Model.PhotoUrl))
        {
            <img src="@Model.PhotoUrl" alt="@Model.Name" class="img-thumbnail" style="max-width:200px;" />
        }
    </div>
</div>

<!-- Форма за додади во кошничка со бројчена влез (ограничена со достапни примери) -->
<form asp-controller="ShoppingCart" asp-action="AddToCart" method="post" class="mb-3">
    <input type="hidden" name="bookId" value="@Model.Id" />
    <div class="form-group">
        <label for="quantity">Колку:</label>
        <input type="number"
               id="quantity"
               name="quantity"
               value="1"
               min="1"
               max="@Model.CopiesAvailable"
               class="form-control"
               style="width: 100px;" />
    </div>
    <button type="submit" class="btn btn-success mt-2" @(Model.CopiesAvailable == 0 ? "disabled" : "")>Додади во кошничка</button>
</form>

<div>
    <a asp-action="Index" class="btn btn-secondary">Назад кон книгите</a>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Измени</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Избриши</a>
    }
</div>
