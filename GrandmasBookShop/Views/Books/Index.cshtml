@model GrandmasBookShop.Models.BooksIndexViewModel

@{
    ViewData["Title"] = "Книги";
}

<h1>Книги</h1>

<!-- Форма за пребарување -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchString" value="@Model.SearchString" class="form-control" placeholder="Пребарај по име или автор" />
        <span class="input-group-btn">
            <button class="btn btn-primary" type="submit">Пребарај</button>
        </span>
    </div>
</form>

<!-- Грид за книги (3 книги по ред) -->
<div class="row">
    @foreach (var book in Model.Books)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(book.PhotoUrl))
                {
                    <img src="@book.PhotoUrl" class="card-img-top" alt="@book.Name" style="height: 200px; object-fit: cover;" />
                }
                else
                {
                    <img src="/images/default-book.jpg" class="card-img-top" alt="Default Book Image" style="height: 200px; object-fit: cover;" />
                }
                <div class="card-body">
                    <h5 class="card-title">@book.Name</h5>
                    <p class="card-text">
                        @if (book.CopiesAvailable == 0)
                        {
                            <span class="text-danger">Продадено</span>
                        }
                        else
                        {
                            @string.Format("{0:N0} ден", book.Price)
                        }
                    </p>
                </div>
                <div class="card-footer text-center">
                    <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-primary">Детали</a>
                </div>
            </div>
        </div>
    }
</div>

<!-- Пагинација -->
<nav aria-label="Навигација на страници">
    <ul class="pagination justify-content-center">
        @if (Model.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchString="@Model.SearchString">Претходна</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link">Претходна</span>
            </li>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            if (i == Model.CurrentPage)
            {
                <li class="page-item active">
                    <span class="page-link">@i</span>
                </li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@Model.SearchString">@i</a>
                </li>
            }
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchString="@Model.SearchString">Следна</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link">Следна</span>
            </li>
        }
    </ul>
</nav>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-success">Додај нова книга</a>
    </p>
}
