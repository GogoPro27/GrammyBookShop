@model GrandmasBookShop.Models.BooksIndexViewModel

@{
    ViewData["Title"] = "Books";
}

<h1>Books</h1>

<!-- Search Form (optional) -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchString" value="@Model.SearchString" class="form-control" placeholder="Search by name or author" />
        <span class="input-group-btn">
            <button class="btn btn-primary" type="submit">Search</button>
        </span>
    </div>
</form>

<!-- Books Grid -->
<div class="row">
    @foreach (var book in Model.Books)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(book.PhotoUrl))
                {
                    <img src="@book.PhotoUrl" class="card-img-top" alt="@book.Name" style="height: 200px; object-fit: cover;" />
                }
                else
                {
                    <img src="/images/default-book.jpg" class="card-img-top" alt="Default Book Image" style="height: 200px; object-fit: cover;" />
                }
                <div class="card-body">
                    <h5 class="card-title">@book.Name</h5>
                    <p class="card-text">
                        @if (book.CopiesAvailable == 0)
                        {
                            <span class="text-danger">Sold Out</span>
                        }
                        else
                        {
                            @book.Price.ToString("C")
                        }
                    </p>
                </div>
                <div class="card-footer text-center">
                    <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-primary">View Details</a>
                </div>
            </div>
        </div>
    }
</div>


<!-- Pagination -->
<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        @if (Model.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchString="@Model.SearchString">Previous</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link">Previous</span>
            </li>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            if (i == Model.CurrentPage)
            {
                <li class="page-item active">
                    <span class="page-link">@i</span>
                </li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@Model.SearchString">@i</a>
                </li>
            }
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchString="@Model.SearchString">Next</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link">Next</span>
            </li>
        }
    </ul>
</nav>
