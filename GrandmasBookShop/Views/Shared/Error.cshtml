@model GrandmasBookShop.Models.ErrorViewModel
@{
    ViewData["Title"] = "Грешка";
}

<h1 class="text-danger">Грешка.</h1>
<h2 class="text-danger">Се случи грешка при обработката на вашето барање.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Идентификатор на барање:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Режим на развој</h3>
<p>
    Промена кон <strong>Развој</strong> режим ќе прикаже подетални информации за грешката.
</p>
<p>
    <strong>Режимот на развој не треба да биде овозможен за публично достапни апликации.</strong>
    Ова може да резултира со прикажување на чувствителни информации до крајните корисници.
    За локално откривање на грешки, овозможете го режимот <strong>Развој</strong> со поставување на променливата на опкружување <strong>ASPNETCORE_ENVIRONMENT</strong> на <strong>Development</strong> и рестартирајте ја апликацијата.
</p>
